<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= category %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

    <%- include('navbar', {links: links}) %>
    
<div class="category">
    <h1><%= category %></h1>
    <h2>Categories</h2>

   <div class="categoryBtnsSecond">

        <% for (let i =0; i < categories.length; i++) { %>
        <a href="/category/<%= categories[i].category %>"><%- categories[i].category %></a>
        <% } %>
    </div>

    <div class="productCardArea">
        
            <% for (let i =0; i < products.length; i++) { %>
        <%- include('product', {product: products[i]}) %>
        <% } %>
            
        
    </div>
    </div>
</body>
</html>